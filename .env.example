# Santhra environment (copy to .env)
# No API keys are required. The system runs entirely locally.

# Backend
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./santhra.db     # PostgreSQL-compatible, e.g. postgresql+psycopg://user:pass@host/db
MODEL_PATH=ml/checkpoints/model.pt
ANOMALY_MODEL_PATH=ml/checkpoints/anomaly.pt
CALIBRATION_PATH=ml/checkpoints/calibration.json
MAX_UPLOAD_SIZE_MB=15
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
LOG_LEVEL=INFO
SANTHRA_DEVICE=auto                               # auto | cpu | cuda

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
